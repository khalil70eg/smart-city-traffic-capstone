<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="traffic.db" readonly="0" foreign_keys="0" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1416"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="traffic" custom_title="0" dock_id="1" table="4,7:maintraffic"/><dock_state state="000000ff00000000fd000000010000000200000720000004fefc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000007200000016400ffffff000007200000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="traffic" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="54"/><column index="3" value="51"/><column index="4" value="59"/><column index="5" value="64"/><column index="6" value="101"/><column index="7" value="257"/><column index="8" value="156"/><column index="9" value="89"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="1.2 Analyse annual traffic trends">WITH yearly AS (
    SELECT
        strftime('%Y', date_time) AS year,
        COUNT(*) AS records,
        COUNT(DISTINCT strftime('%m', date_time)) AS months_covered,
        SUM(CAST(traffic_volume AS INTEGER)) AS total,
        AVG(CAST(traffic_volume AS INTEGER)) AS avg_per_hour
    FROM traffic
    WHERE strftime('%Y', date_time) BETWEEN '2012' AND '2017'
    GROUP BY year
)
SELECT
    year,
    records,
    months_covered,
    total,
    total - LAG(total) OVER (ORDER BY year) AS total_change,
    ROUND(100.0 * (total - LAG(total) OVER (ORDER BY year))
          / LAG(total) OVER (ORDER BY year), 1) AS total_pct_change,
    CASE
        WHEN LAG(total) OVER (ORDER BY year) IS NULL THEN 'first year'
        WHEN total &gt; LAG(total) OVER (ORDER BY year) THEN 'increase'
        WHEN total &lt; LAG(total) OVER (ORDER BY year) THEN 'decrease'
        ELSE 'no change'
    END AS total_trend,
    ROUND(avg_per_hour, 1) AS avg_per_hour,
    ROUND(100.0 * (avg_per_hour - LAG(avg_per_hour) OVER (ORDER BY year))
          / LAG(avg_per_hour) OVER (ORDER BY year), 1) AS avg_pct_change
FROM yearly
ORDER BY year;</sql><sql name="1.3 Analyse temperature around holidays">SELECT
    holiday,
    strftime('%Y', date_time)                        AS year,
    COUNT(*)                                         AS records,
    ROUND(MIN(CAST(temp AS REAL) - 273.15), 1)       AS min_temp_c,
    ROUND(AVG(CAST(temp AS REAL) - 273.15), 1)       AS avg_temp_c,
    ROUND(MAX(CAST(temp AS REAL) - 273.15), 1)       AS max_temp_c
FROM traffic
WHERE holiday IN ('New Years Day', 'Labor Day')
  AND strftime('%Y', date_time) IN ('2015', '2016', '2017')
  AND CAST(temp AS REAL) &gt; 0
GROUP BY holiday, year
ORDER BY holiday, year;</sql><sql name="1.3 Analyse temperature around holidays_1">WITH holiday_days AS (
    SELECT DISTINCT date(date_time) AS day, holiday
    FROM traffic
    WHERE holiday IN ('New Years Day', 'Labor Day')
      AND strftime('%Y', date_time) IN ('2015', '2016', '2017')
),
daily AS (
    SELECT
        h.holiday,
        strftime('%Y', t.date_time)                AS year,
        COUNT(*)                                   AS records,
        AVG(CAST(t.temp AS REAL) - 273.15)         AS avg_temp_c,
        AVG(CAST(t.traffic_volume AS INTEGER))     AS avg_traffic,
        SUM(CAST(t.rain_1h AS REAL))               AS total_rain_mm,
        SUM(CAST(t.snow_1h AS REAL))               AS total_snow_mm
    FROM traffic t
    JOIN holiday_days h ON date(t.date_time) = h.day
    WHERE CAST(t.temp AS REAL) &gt; 0
    GROUP BY h.holiday, year
)
SELECT holiday, year, records,
       ROUND(avg_temp_c, 1)    AS avg_temp_c,
       ROUND(avg_traffic, 0)   AS avg_traffic,
       ROUND(total_rain_mm, 1) AS rain_mm,
       ROUND(total_snow_mm, 1) AS snow_mm
FROM daily
ORDER BY holiday, year;</sql><sql name="2.1 Traffic volume statistics">WITH RECURSIVE vals AS (
    SELECT CAST(traffic_volume AS REAL) AS v
    FROM traffic
    WHERE CAST(traffic_volume AS REAL) &gt; -1      -- use &gt; 0 to exclude zero readings
),
stats AS (
    SELECT COUNT(*) AS n, AVG(v) AS mean, MIN(v) AS min_v, MAX(v) AS max_v
    FROM vals
),
var AS (
    SELECT SUM((v - (SELECT mean FROM stats)) * (v - (SELECT mean FROM stats)))
           / ((SELECT n FROM stats) - 1) AS variance
    FROM vals
),
sqrt_calc(i, x) AS (
    SELECT 0, (SELECT variance FROM var) / 2.0
    UNION ALL
    SELECT i + 1, (x + (SELECT variance FROM var) / x) / 2.0
    FROM sqrt_calc
    WHERE i &lt; 30
),
std AS (
    SELECT x AS std_dev FROM sqrt_calc WHERE i = 30
),
ordered AS (
    SELECT v, ROW_NUMBER() OVER (ORDER BY v) AS rn
    FROM vals
),
median AS (
    SELECT AVG(v) AS median
    FROM ordered
    WHERE rn IN (((SELECT n FROM stats) + 1) / 2,
                 ((SELECT n FROM stats) + 2) / 2)
)
SELECT
    s.n                       AS records,
    ROUND(s.mean, 2)          AS mean,
    m.median                  AS median,
    ROUND(sd.std_dev, 2)      AS std_dev,
    ROUND(vr.variance, 2)     AS variance,
    s.max_v - s.min_v         AS range,
    s.min_v                   AS min,
    s.max_v                   AS max
FROM stats s, var vr, std sd, median m;</sql><sql name="2.2 Correlation analysis">WITH RECURSIVE vals AS (
    SELECT
        CAST(temp AS REAL) - 273.15      AS x,   -- temperature in °C
        CAST(traffic_volume AS REAL)     AS y    -- traffic volume
    FROM traffic
    WHERE CAST(temp AS REAL) &gt; 0
),
means AS (
    SELECT COUNT(*) AS n, AVG(x) AS mx, AVG(y) AS my
    FROM vals
),
sums AS (
    SELECT
        SUM((x - m.mx) * (y - m.my)) AS sxy,
        SUM((x - m.mx) * (x - m.mx)) AS sxx,
        SUM((y - m.my) * (y - m.my)) AS syy
    FROM vals, means m
),
sqrt_calc(i, s) AS (
    SELECT 0, (SELECT sxx * syy FROM sums) / 2.0
    UNION ALL
    SELECT i + 1, (s + (SELECT sxx * syy FROM sums) / s) / 2.0
    FROM sqrt_calc
    WHERE i &lt; 60
)
SELECT
    (SELECT n FROM means)                                     AS records,
    ROUND(sums.sxy / sq.s, 4)                                 AS correlation_r,
    ROUND((sums.sxy * sums.sxy) / (sums.sxx * sums.syy), 4)   AS r_squared
FROM sums,
     (SELECT s FROM sqrt_calc WHERE i = 60) sq;</sql><sql name="3.1 Basic probability">SELECT
    COUNT(*) AS total_records,

    SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500 THEN 1 ELSE 0 END)
        AS congestion_count,
    SUM(CASE WHEN weather_main = 'Clear' THEN 1 ELSE 0 END)
        AS clear_count,
    SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500
              AND weather_main = 'Clear' THEN 1 ELSE 0 END)
        AS congestion_and_clear_count,

    ROUND(1.0 * SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500 THEN 1 ELSE 0 END)
          / COUNT(*), 4) AS p_congestion,
    ROUND(1.0 * SUM(CASE WHEN weather_main = 'Clear' THEN 1 ELSE 0 END)
          / COUNT(*), 4) AS p_clear,
    ROUND(1.0 * SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500
                          AND weather_main = 'Clear' THEN 1 ELSE 0 END)
          / COUNT(*), 4) AS p_congestion_and_clear
FROM traffic;</sql><sql name="3.2 Conditional probability">SELECT
    SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500 THEN 1 ELSE 0 END)
        AS congestion_count,

    ROUND(1.0 * SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500
                          AND weather_main = 'Clear' THEN 1 ELSE 0 END)
          / SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500 THEN 1 ELSE 0 END), 4)
        AS p_clear_given_congestion,

    ROUND(1.0 * SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500
                          AND CAST(temp AS REAL) &gt; 292 THEN 1 ELSE 0 END)
          / SUM(CASE WHEN CAST(traffic_volume AS INTEGER) &gt; 5500 THEN 1 ELSE 0 END), 4)
        AS p_high_temp_given_congestion
FROM traffic;</sql><current_tab id="6"/></tab_sql></sqlb_project>
